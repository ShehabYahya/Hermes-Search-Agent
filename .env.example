# Dedicated Hermes research profile API
HERMES_RESEARCH_URL=http://127.0.0.1:8643
HERMES_RESEARCH_API_KEY=change-me

# MCP server bind address
HERMES_SEARCH_MCP_BIND=127.0.0.1:8932

# Hard ceilings. Hermes still decides when research is sufficiently complete.
HERMES_SEARCH_LIGHT_TIMEOUT_SECS=30
HERMES_SEARCH_MEDIUM_TIMEOUT_SECS=120
HERMES_SEARCH_DEEP_TIMEOUT_SECS=360
